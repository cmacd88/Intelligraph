# Set to run a second, fully isolated stack alongside this one (separate
# containers, volumes and network) without cloning the repo again — give it
# a distinct name, a distinct .env file, and distinct ports below, then:
#   docker compose --env-file .env.<project> -p <project> up -d
# or export COMPOSE_PROJECT_NAME=<project> instead of -p. Leave unset for
# the default single-stack setup.
COMPOSE_PROJECT_NAME=intelligraph

# Password must be 8+ characters or Neo4j refuses to start.
NEO4J_PASSWORD=change-me-please
NEO4J_USER=neo4j

# Bound to localhost only. Change to 0.0.0.0 when you add the edge layer.
# Running a second stack in parallel? Every port below must differ from the
# other stack's — COMPOSE_PROJECT_NAME alone does not avoid port clashes.
BIND_ADDR=127.0.0.1
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
API_PORT=4000
WEB_PORT=8080

# Raise for larger graphs. Pagecache should exceed your store size if possible.
NEO4J_HEAP_MAX=2G
NEO4J_PAGECACHE=1G

# Set to 1 to load sample data on an empty database.
SEED=0
