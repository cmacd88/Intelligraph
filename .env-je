# This is the SECOND stack's env file — pass it explicitly, it doesn't
# replace your default .env:
#   docker compose --env-file .env.caseb -p caseb up -d
COMPOSE_PROJECT_NAME=caseb

# Password must be 8+ characters or Neo4j refuses to start.
# Use a different password than your first stack's — these are two
# independent Neo4j instances, not a shared one.
NEO4J_PASSWORD=change-me-too
NEO4J_USER=neo4j

# Bound to localhost only. Change to 0.0.0.0 when you add the edge layer.
# Every port here must differ from the other stack's — COMPOSE_PROJECT_NAME
# alone only isolates containers/volumes/network, not ports.
BIND_ADDR=127.0.0.1
NEO4J_HTTP_PORT=7475
NEO4J_BOLT_PORT=7688
API_PORT=4001
WEB_PORT=8081

# Raise for larger graphs. Pagecache should exceed your store size if possible.
NEO4J_HEAP_MAX=2G
NEO4J_PAGECACHE=1G

# Set to 1 to load sample data on an empty database.
SEED=0
